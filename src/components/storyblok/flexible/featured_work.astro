---
import { storyblokEditable } from '@storyblok/astro'

const { blok } = Astro.props
const featuredWork = blok.items
---
<div class="flex flex-col gap-4" {...storyblokEditable(blok)}>
  {featuredWork.map((work) => (
    <section class="md:flex flex-row gap-2">
      <div class="image md:w-1/2">
        IMAGE
      </div>
      <div class="content md:w-1/2">
        {work.name && <h2 class="text-3xl font-bold">{work.name}</h2>}
        <pre>{JSON.stringify(work, null, 2)}</pre>
        {work?.content?.url && (
          <a href="" class="btn px-4 py-2 dark:bg-white bg-stone-900 dark:text-stone-900 text-white">View Project</a>
        )}
      </div>
    </section>
  ))}
</div>